{
  "name": "vibe-gain",
  "version": "0.1.8",
  "description": "Visualize GitHub commit patterns to evaluate vibe-coding productivity gains",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    "./lib/*": "./lib/*.js",
    "./core/*": "./core/*.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cyberchitta/vibe-gain.git"
  },
  "scripts": {
    "start": "bun lib/download-commits.js",
    "serve": "bunx http-server . --cors -p 3001",
    "gen-llm-report": "bun lib/export/gen-all-plots-llm.js",
    "test": "bun test",
    "typecheck": "bunx -p typescript@7.0.2 tsc -p jsconfig.json"
  },
  "dependencies": {
    "@octokit/graphql": "^9.0.5",
    "@octokit/rest": "^22.0.1",
    "dotenv": "^18.0.9"
  },
  "optionalDependencies": {
    "vega": "^6.4.0",
    "vega-lite": "^6.5.0"
  },
  "license": "Apache-2.0"
}
